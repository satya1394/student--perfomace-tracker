# ==========================================
# Student Performance Tracker - Environment Variables
# ==========================================

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@hostname:port/database_name
# For SQLite local fallback during testing: sqlite:///student_tracker.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_performance_db

# Flask & Security Settings
SECRET_KEY=super-secret-key-change-in-production-random-hash-2026
FLASK_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8050

# Flask-Mail (Automated Email Alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=academic-alerts@university.edu
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=academic-alerts@university.edu

# Model Storage Paths
MODEL_DIR=app/ml_models/models

# Logging
LOG_LEVEL=INFO
